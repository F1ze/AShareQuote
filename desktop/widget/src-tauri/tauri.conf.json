{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QFLUX Widget",
  "version": "0.1.0",
  "identifier": "local.qflux.widget",
  "build": {
    "beforeDevCommand": "npm --prefix ../../frontend run build",
    "beforeBuildCommand": "npm --prefix ../../frontend run build",
    "frontendDist": "../../../frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "QFLUX · 轻量行情",
        "url": "index.html?widget=1",
        "width": 460,
        "height": 285,
        "minWidth": 340,
        "minHeight": 180,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": true,
        "shadow": true,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Lightweight native quote widget backed by QFLUX",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
